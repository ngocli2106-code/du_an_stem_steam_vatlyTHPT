# Sao chép thành .env (npm run setup sẽ tự tạo nếu chưa có).
DATABASE_URL="file:../data/app.db"
# Chuỗi bí mật ký phiên đăng nhập (>= 32 ký tự). KHÔNG dùng lại giá trị này ở môi trường thật.
AUTH_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
# Mật khẩu chung cho tài khoản demo do seed tạo ra (chỉ để dùng thử cục bộ).
DEMO_PASSWORD="demo-stem-2026"
# Thư mục lưu minh chứng (ngoài public). Mặc định ./data/uploads
UPLOAD_DIR="./data/uploads"
