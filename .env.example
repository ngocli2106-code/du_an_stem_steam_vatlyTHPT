# Sao chép thành .env (npm run setup sẽ tự tạo nếu chưa có).

# Postgres. Máy cá nhân: `npm run db:up` (Docker) rồi dùng hai dòng dưới.
# Trên Vercel: tích hợp Neon tự đặt DATABASE_URL (qua pooler) và DATABASE_URL_UNPOOLED (trực tiếp).
DATABASE_URL="postgresql://stem:stem-local-only@localhost:5432/stem"
DATABASE_URL_UNPOOLED="postgresql://stem:stem-local-only@localhost:5432/stem"

# Chuỗi bí mật ký phiên đăng nhập (>= 32 ký tự). KHÔNG dùng lại giá trị này ở bản deploy.
AUTH_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"

# Mật khẩu chung cho tài khoản demo do seed tạo ra. Bản deploy bắt buộc đặt giá trị riêng (>= 10 ký tự).
DEMO_PASSWORD="demo-stem-2026"

# Nơi lưu minh chứng: local (thư mục UPLOAD_DIR) hoặc vercel-blob (kho riêng tư; mặc định khi chạy trên Vercel).
STORAGE_DRIVER="local"
UPLOAD_DIR="./data/uploads"
# BLOB_READ_WRITE_TOKEN="" # Vercel tự đặt khi kết nối kho Blob với dự án
