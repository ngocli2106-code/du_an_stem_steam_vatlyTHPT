generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: TEACHER | STUDENT
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  studentCode  String?  @unique
  role         String
  passwordHash String
  createdAt    DateTime @default(now())

  taughtClasses Class[]       @relation("Teacher")
  memberships   ClassMember[]
  groupMembers  GroupMember[]
  contributions Contribution[]
  templates     Template[]
}

model Class {
  id        String   @id @default(cuid())
  name      String
  grade     Int
  teacherId String
  teacher   User     @relation("Teacher", fields: [teacherId], references: [id])
  createdAt DateTime @default(now())

  members  ClassMember[]
  groups   Group[]
  projects Project[]
}

model ClassMember {
  id      String @id @default(cuid())
  classId String
  userId  String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
}

model Group {
  id      String @id @default(cuid())
  classId String
  name    String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  members       GroupMember[]
  projectGroups ProjectGroup[]
}

model GroupMember {
  id        String  @id @default(cuid())
  groupId   String
  classId   String
  userId    String
  roleLabel String  @default("")
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
}

// Mẫu dự án (key != null: mẫu hệ thống; ownerId != null: mẫu của giáo viên)
model Template {
  id          String   @id @default(cuid())
  key         String?  @unique
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id])
  title       String
  grade       Int
  mode        String // STEM | STEAM
  contentJson String
  rubricJson  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]
}

// Dự án được giao cho một lớp. contentJson/rubricJson là bản chụp tại thời điểm giao.
model Project {
  id          String    @id @default(cuid())
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title       String
  mode        String // STEM | STEAM
  kind        String // FULL | SHORT
  grade       Int
  goals       String
  durationWeeks Int
  dueDate     DateTime
  isDemo      Boolean   @default(false)
  contentJson String
  rubricJson  String
  createdAt   DateTime  @default(now())

  stages        ProjectStage[]
  projectGroups ProjectGroup[]
}

model ProjectStage {
  id        String    @id @default(cuid())
  projectId String
  stageKey  Int
  dueDate   DateTime?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageKey])
}

// Hồ sơ của một nhóm trong một dự án
model ProjectGroup {
  id             String   @id @default(cuid())
  projectId      String
  groupId        String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  gradeDraftJson String?
  publishedJson  String?
  publishedAt    DateTime?

  stageWorks    StageWork[]
  evidences     Evidence[]
  contributions Contribution[]

  @@unique([projectId, groupId])
}

// status: NOT_STARTED | IN_PROGRESS | SUBMITTED | NEEDS_REVISION | APPROVED
model StageWork {
  id             String   @id @default(cuid())
  projectGroupId String
  stageKey       Int
  status         String   @default("NOT_STARTED")
  draftJson      String   @default("{}")
  version        Int      @default(0)
  updatedAt      DateTime @default(now())
  updatedById    String?
  projectGroup   ProjectGroup @relation(fields: [projectGroupId], references: [id], onDelete: Cascade)

  submissions Submission[]
  feedbacks   Feedback[]

  @@unique([projectGroupId, stageKey])
}

model Submission {
  id            String   @id @default(cuid())
  stageWorkId   String
  number        Int
  contentJson   String
  submittedById String
  submittedAt   DateTime @default(now())
  stageWork     StageWork @relation(fields: [stageWorkId], references: [id], onDelete: Cascade)
  feedbacks     Feedback[]

  @@unique([stageWorkId, number])
}

// kind: COMMENT | REVISION | APPROVE
model Feedback {
  id           String   @id @default(cuid())
  stageWorkId  String
  submissionId String
  authorId     String
  kind         String
  text         String
  createdAt    DateTime @default(now())
  stageWork    StageWork  @relation(fields: [stageWorkId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Evidence {
  id             String   @id @default(cuid())
  projectGroupId String
  stageKey       Int
  fileName       String
  storedName     String   @unique
  mime           String
  size           Int
  uploaderId     String
  createdAt      DateTime @default(now())
  projectGroup   ProjectGroup @relation(fields: [projectGroupId], references: [id], onDelete: Cascade)
}

// Đóng góp và tự đánh giá của từng học sinh (tách khỏi điểm sản phẩm nhóm)
model Contribution {
  id             String   @id @default(cuid())
  projectGroupId String
  userId         String
  contribution   String   @default("")
  selfEvalJson   String   @default("{}")
  updatedAt      DateTime @default(now())
  projectGroup   ProjectGroup @relation(fields: [projectGroupId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectGroupId, userId])
}
